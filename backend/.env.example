# Database Configuration
DATABASE_URL="postgresql://ecourse:ecourse_secret@localhost:5433/ecourse_db?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=3001
NODE_ENV=development

# Render Configuration (Automatically set by Render)
# RENDER=true
# RENDER_SERVICE_ID=your-service-id

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# MinIO Configuration (Development - for local file storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_PUBLIC=ecourse-public
MINIO_BUCKET_PRIVATE=ecourse-private
MINIO_USE_SSL=false

# Cloudflare R2 Configuration (Production - for cloud file storage)
# The system automatically detects which storage to use based on available configuration
# If R2 credentials are provided, it will use R2; otherwise, it falls back to MinIO
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_BUCKET_PUBLIC=ecourse-public
# R2_BUCKET_PRIVATE=ecourse-private

# AWS S3 Configuration (Optional - for file storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your_bucket_name

# Redis Configuration (Optional - for BullMQ queues)
# IMPORTANT: If Redis is not configured, the application will run without queue functionality
# This is designed for free tier deployments where Redis may not be available

# Local Redis (Development)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Upstash Redis (Production - recommended for cloud deployment)
# UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
# UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Redis URL (Alternative format)
# REDIS_URL=redis://user:password@host:port

# Email Configuration (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@ecourse.com
# SMTP_FROM_NAME=E-Course LMS
# EMAIL_QUEUE_NAME=email-queue

# First Admin Configuration (Optional - for initial admin setup)
# Only creates admin if no users exist in database
# FIRST_ADMIN_EMAIL=admin@yourdomain.com
# FIRST_ADMIN_PASSWORD=SecurePassword123!
# FIRST_ADMIN_NAME=Administrator
