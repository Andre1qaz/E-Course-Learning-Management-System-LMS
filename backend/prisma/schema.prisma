generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = "postgresql://postgres:*V2%26%24bp9x2x%2BpP3@db.klltjysxikbaqumjvtpn.supabase.co:5432/postgres"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  password              String
  role                  Role                   @default(MAHASISWA)
  avatarUrl             String?
  storageQuotaUsed      BigInt                 @default(0)
  storageQuotaLimit     BigInt                 @default(52428800)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  resetToken            String?                @unique
  resetTokenExpires     DateTime?
  activityLogs          ActivityLog[]
  announcementReads     AnnouncementRead[]
  announcements         Announcement[]         @relation("AnnouncementAuthor")
  assignmentSubmissions AssignmentSubmission[]
  calendarEvents        CalendarEvent[]
  coursesTaught         Course[]               @relation("CourseInstructor")
  enrollments           Enrollment[]
  examAttempts          ExamAttempt[]
  forumMentions         ForumMention[]         @relation("Mentioner")
  mentionedInForum      ForumMention[]         @relation("MentionedUser")
  forumReplies          ForumReply[]
  forumThreads          ForumThread[]
  lockedThreads         ForumThread[]          @relation("ThreadLocker")
  gradeChanges          GradeHistory[]
  grades                Grade[]
  notifications         Notification[]
  privateFiles          PrivateFile[]
  quizAttempts          QuizAttempt[]

  @@map("User")
}

model CourseCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  academicYear String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  courses      Course[]

  @@map("course_categories")
}

model Course {
  id                 String          @id @default(cuid())
  name               String
  code               String          @unique
  enrollmentCode     String          @unique @default(cuid())
  description        String?
  learningObjectives String?
  thumbnailColor     String          @default("#1a365d")
  isLinear           Boolean         @default(false)
  isActive           Boolean         @default(true)
  instructorId       String
  categoryId         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  enrollmentEnabled  Boolean         @default(true)
  announcements      Announcement[]
  assignments        Assignment[]
  calendarEvents     CalendarEvent[]
  settings           CourseSettings?
  category           CourseCategory? @relation(fields: [categoryId], references: [id])
  instructor         User            @relation("CourseInstructor", fields: [instructorId], references: [id])
  enrollments        Enrollment[]
  exams              Exam[]
  forumThreads       ForumThread[]
  grades             Grade[]
  modules            Module[]
  questionBanks      QuestionBank[]
  weeks              Week[]

  @@map("courses")
}

model Enrollment {
  id       String         @id @default(cuid())
  userId   String
  courseId String
  role     EnrollmentRole @default(STUDENT)
  joinedAt DateTime       @default(now())
  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Week {
  id         String     @id @default(cuid())
  courseId   String
  weekNumber Int
  title      String
  startDate  DateTime
  endDate    DateTime
  order      Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]
  exams      Exam[]
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, weekNumber])
  @@map("weeks")
}

model Activity {
  id          String         @id @default(cuid())
  weekId      String
  type        ActivityType
  title       String
  description String?
  status      ActivityStatus @default(DRAFT)
  order       Int
  metadata    Json?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  week        Week           @relation(fields: [weekId], references: [id], onDelete: Cascade)
  quiz        Quiz?

  @@map("activities")
}

model Module {
  id                 String       @id @default(cuid())
  courseId           String
  title              String
  description        String?
  learningObjectives String?
  order              Int
  updatedAt          DateTime     @updatedAt
  createdAt          DateTime     @default(now())
  files              ModuleFile[]
  course             Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("modules")
}

model ModuleFile {
  id         String         @id @default(cuid())
  moduleId   String
  fileName   String
  fileUrl    String
  fileType   ModuleFileType @default(OTHER)
  fileSize   BigInt         @default(0)
  uploadedAt DateTime       @default(now())
  module     Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("module_files")
}

model Assignment {
  id          String                 @id @default(cuid())
  courseId    String
  title       String
  description String?
  deadline    DateTime
  maxScore    Float                  @default(100)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  submissions AssignmentSubmission[]
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rubric      Rubric?

  @@map("assignments")
}

model AssignmentSubmission {
  id                String                     @id @default(cuid())
  assignmentId      String
  studentId         String
  fileUrl           String?
  fileName          String?
  submittedAt       DateTime?
  score             Float?
  feedback          String?
  rubricNotes       String?
  status            AssignmentSubmissionStatus @default(NOT_SUBMITTED)
  assignment        Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student           User                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rubricAssessments RubricAssessment[]

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model RubricAssessment {
  id                     String                @id @default(cuid())
  submissionId           String
  rubricCriterionId      String
  rubricCriterionLevelId String?
  score                  Float
  feedback               String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  criterion              RubricCriterion       @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)
  level                  RubricCriterionLevel? @relation(fields: [rubricCriterionLevelId], references: [id])
  submission             AssignmentSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, rubricCriterionId])
  @@map("rubric_assessments")
}

model Rubric {
  id           String            @id @default(cuid())
  assignmentId String            @unique
  name         String
  description  String?
  totalPoints  Float             @default(100)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  criteria     RubricCriterion[]
  assignment   Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("rubrics")
}

model RubricCriterion {
  id          String                 @id @default(cuid())
  rubricId    String
  name        String
  description String?
  maxPoints   Float
  order       Int
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  assessments RubricAssessment[]
  rubric      Rubric                 @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  levels      RubricCriterionLevel[]

  @@map("rubric_criteria")
}

model RubricCriterionLevel {
  id          String             @id @default(cuid())
  criterionId String
  name        String
  description String
  points      Float
  order       Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  assessments RubricAssessment[]
  criterion   RubricCriterion    @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@map("rubric_criterion_levels")
}

model Exam {
  id               String        @id @default(cuid())
  courseId         String
  title            String
  description      String?
  startTime        DateTime
  duration         Int
  deadline         DateTime
  isPublished      Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  allowBack        Boolean       @default(true)
  allowReview      Boolean       @default(false)
  autoSubmit       Boolean       @default(true)
  category         ExamCategory  @default(GENERAL)
  maxAttempts      Int           @default(1)
  maxScore         Float         @default(100)
  passingGrade     Float         @default(60)
  showExplanation  Boolean       @default(false)
  showResults      Boolean       @default(true)
  shuffleOptions   Boolean       @default(false)
  shuffleQuestions Boolean       @default(false)
  weekId           String?
  attempts         ExamAttempt[]
  course           Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  week             Week?         @relation(fields: [weekId], references: [id])
  questions        Question[]

  @@map("exams")
}

model Question {
  id             String           @id @default(cuid())
  examId         String?
  type           QuestionType
  questionText   String
  attachmentUrl  String?
  points         Float            @default(1)
  order          Int              @default(0)
  allowMultiple  Boolean          @default(false)
  caseSensitive  Boolean          @default(false)
  createdAt      DateTime         @default(now())
  difficulty     DifficultyLevel  @default(MEDIUM)
  explanation    String?
  isFromBank     Boolean          @default(false)
  maxChars       Int?
  questionBankId String?
  rubric         String?
  tolerance      Float?
  updatedAt      DateTime         @updatedAt
  answers        Answer[]
  options        QuestionOption[]
  tags           QuestionTag[]
  exam           Exam?            @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionBank   QuestionBank?    @relation(fields: [questionBankId], references: [id])

  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  optionText String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  answers    Answer[]
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model QuestionBank {
  id           String          @id @default(cuid())
  courseId     String?
  title        String
  description  String?
  topic        String?
  difficulty   DifficultyLevel @default(MEDIUM)
  questionType QuestionType
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  course       Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]

  @@map("question_banks")
}

model QuestionTag {
  id         String   @id @default(cuid())
  questionId String
  tag        String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, tag])
  @@map("question_tags")
}

model ExamAttempt {
  id            String            @id @default(cuid())
  examId        String
  studentId     String
  startedAt     DateTime?
  submittedAt   DateTime?
  totalScore    Float?
  status        ExamAttemptStatus @default(NOT_STARTED)
  examCheatLog  Json              @default("[]")
  attemptNumber Int               @default(1)
  autoSavedData Json?
  createdAt     DateTime          @default(now())
  gradingStatus GradingStatus     @default(PENDING)
  passed        Boolean?
  updatedAt     DateTime          @updatedAt
  answers       Answer[]
  exam          Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, attemptNumber])
  @@map("exam_attempts")
}

model Answer {
  id               String          @id @default(cuid())
  attemptId        String
  questionId       String
  answerText       String?
  selectedOptionId String?
  score            Float?
  feedback         String?
  attempt          ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("answers")
}

model CalendarEvent {
  id                  String              @id @default(cuid())
  title               String
  description         String?
  type                CalendarEventType   @default(ANNOUNCEMENT)
  userId              String?
  courseId            String?
  createdAt           DateTime            @default(now())
  attachments         Json?
  category            EventCategory       @default(PENGUMUMAN_AKADEMIK)
  color               String              @default("#1a365d")
  endDate             DateTime?
  endTime             String?
  isOnline            Boolean             @default(false)
  isPublished         Boolean             @default(true)
  location            String?
  meetingLink         String?
  relatedActivityId   String?
  relatedActivityType RelatedActivityType @default(NONE)
  startDate           DateTime
  startTime           String?
  targetAudience      EventTargetAudience @default(COURSE_STUDENTS)
  updatedAt           DateTime            @updatedAt
  course              Course?             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user                User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

model PrivateFile {
  id         String   @id @default(cuid())
  userId     String
  fileName   String
  fileUrl    String
  fileSize   BigInt
  folderPath String   @default("/")
  mimeType   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("private_files")
}

model ForumThread {
  id          String            @id @default(cuid())
  courseId    String
  authorId    String
  title       String
  content     String
  isPinned    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  bestReplyId String?           @unique
  isLocked    Boolean           @default(false)
  lockedAt    DateTime?
  lockedBy    String?
  attachments ForumAttachment[]
  mentions    ForumMention[]
  replies     ForumReply[]
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  bestReply   ForumReply?       @relation("BestReply", fields: [bestReplyId], references: [id])
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  locker      User?             @relation("ThreadLocker", fields: [lockedBy], references: [id])

  @@map("forum_threads")
}

model ForumReply {
  id          String            @id @default(cuid())
  threadId    String
  authorId    String
  content     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  attachments ForumAttachment[]
  mentions    ForumMention[]
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  thread      ForumThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  bestThread  ForumThread?      @relation("BestReply")

  @@map("forum_replies")
}

model ForumAttachment {
  id         String       @id @default(cuid())
  threadId   String?
  replyId    String?
  fileName   String
  fileUrl    String
  fileSize   BigInt
  mimeType   String
  uploadedAt DateTime     @default(now())
  reply      ForumReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)
  thread     ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("forum_attachments")
}

model ForumMention {
  id              String       @id @default(cuid())
  threadId        String?
  replyId         String?
  mentionedUserId String
  mentionedBy     String
  createdAt       DateTime     @default(now())
  mentioner       User         @relation("Mentioner", fields: [mentionedBy], references: [id], onDelete: Cascade)
  mentionedUser   User         @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  reply           ForumReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)
  thread          ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("forum_mentions")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model CourseSettings {
  id               String   @id @default(cuid())
  courseId         String   @unique
  passingGrade     Float    @default(60)
  assignmentWeight Float    @default(0.3)
  quizWeight       Float    @default(0.2)
  utsWeight        Float    @default(0.2)
  uasWeight        Float    @default(0.3)
  otherWeight      Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_settings")
}

model Grade {
  id                   String         @id @default(cuid())
  courseId             String
  studentId            String
  assignmentScore      Float?         @default(0)
  quizScore            Float?         @default(0)
  utsScore             Float?         @default(0)
  uasScore             Float?         @default(0)
  otherScore           Float?         @default(0)
  finalScore           Float?         @default(0)
  passed               Boolean?
  completionPercentage Float          @default(0)
  calculatedAt         DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  histories            GradeHistory[]
  course               Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student              User           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@map("grades")
}

model GradeHistory {
  id           String   @id @default(cuid())
  gradeId      String
  changedBy    String
  fieldName    String
  oldValue     Float?
  newValue     Float?
  changeReason String?
  changedAt    DateTime @default(now())
  changer      User     @relation(fields: [changedBy], references: [id], onDelete: Cascade)
  grade        Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@map("grade_histories")
}

model Quiz {
  id                String        @id @default(cuid())
  activityId        String        @unique
  title             String
  description       String?
  duration          Int           @default(30)
  passingScore      Float         @default(60)
  allowRetake       Boolean       @default(false)
  maxAttempts       Int           @default(1)
  isPublished       Boolean       @default(false)
  showResults       Boolean       @default(true)
  showExplanation   Boolean       @default(false)
  shuffleQuestions  Boolean       @default(false)
  shuffleOptions    Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  activity          Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  questions         QuizQuestion[]
  attempts          QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id             String           @id @default(cuid())
  quizId         String
  type           QuestionType
  questionText   String
  points         Float            @default(1)
  order          Int              @default(0)
  explanation    String?
  difficulty     DifficultyLevel  @default(MEDIUM)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  quiz           Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options        QuizQuestionOption[]
  answers        QuizAnswer[]

  @@map("quiz_questions")
}

model QuizQuestionOption {
  id         String   @id @default(cuid())
  questionId String
  optionText String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  answers    QuizAnswer[]
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("quiz_question_options")
}

model QuizAttempt {
  id            String            @id @default(cuid())
  quizId        String
  studentId     String
  startedAt     DateTime?
  submittedAt   DateTime?
  totalScore    Float?
  status        QuizAttemptStatus @default(NOT_STARTED)
  attemptNumber Int               @default(1)
  autoSavedData Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  passed        Boolean?
  quiz          Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student       User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers       QuizAnswer[]

  @@unique([quizId, studentId, attemptNumber])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id               String           @id @default(cuid())
  attemptId        String
  questionId       String
  answerText       String?
  selectedOptionId String?
  score            Float?
  feedback         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  attempt          QuizAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuizQuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("quiz_answers")
}

enum QuizAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  content     String
  attachments Json?
  publishedAt DateTime           @default(now())
  validFrom   DateTime           @default(now())
  validUntil  DateTime?
  isPublished Boolean            @default(true)
  priority    String             @default("normal")
  courseId    String?
  authorId    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  readStatus  AnnouncementRead[]
  author      User               @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  course      Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

enum Role {
  ADMIN
  DOSEN
  MAHASISWA
}

enum EnrollmentRole {
  STUDENT
  ASSISTANT
}

enum AssignmentSubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  LATE
  GRADED
}

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY
  SHORT_ANSWER
  TRUE_FALSE
}

enum ExamCategory {
  QUIZ
  UTS
  UAS
  GENERAL
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum GradingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ExamAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum CalendarEventType {
  DEADLINE
  PERSONAL_NOTE
  ANNOUNCEMENT
}

enum EventCategory {
  PERKULIAHAN
  MATERI_BARU
  ASSIGNMENT
  QUIZ
  UTS
  UAS
  SEMINAR
  PROJECT
  MEETING
  DEADLINE
  PENGUMUMAN_AKADEMIK
}

enum EventTargetAudience {
  ALL_STUDENTS
  COURSE_STUDENTS
}

enum RelatedActivityType {
  ASSIGNMENT
  EXAM
  MODULE
  ACTIVITY
  NONE
}

enum NotificationType {
  DEADLINE_REMINDER
  EXAM_REMINDER
  GRADE_RELEASED
  FORUM_REPLY
  SYSTEM
  ANNOUNCEMENT_CREATED
  COURSE_CREATED
  MATERIAL_PUBLISHED
  ASSIGNMENT_CREATED
  QUIZ_CREATED
  EXAM_CREATED
  EVENT_CREATED
  SCHEDULE_CHANGED
}

enum ModuleFileType {
  PDF
  VIDEO
  DOCUMENT
  SLIDE
  OTHER
}

enum ActivityType {
  MATERIAL
  ASSIGNMENT
  QUIZ
  FORUM
  VIDEO
  EXTERNAL_LINK
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
}
